<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carta para ti ❤️</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      font-family: 'Poppins', sans-serif;
    }

    .box {
      width: 200px;
      height: 200px;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .box:hover {
      transform: scale(1.05);
    }

    .lid {
      width: 200px;
      height: 50px;
      background: #ff6f91;
      border-radius: 12px 12px 0 0;
      position: relative;
      top: -125px;
      transition: transform 0.6s ease;
    }

    .message {
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      text-align: center;
      padding: 10px;
      color: #333;
      transition: all 0.6s ease;
    }

    .open .lid {
      transform: translateY(-100px) rotate(-10deg);
    }

    .open .message {
      opacity: 1;
      max-height: 200px;
    }
  </style>
</head>
<body>
  <div class="box" id="loveBox">
    <div class="lid"></div>
    <div class="message">
      <h2>💌 Para ti</h2>
      <p>Eres lo mejor que me ha pasado ❤️</p>
    </div>
  </div>

  <script>
    const box = document.getElementById('loveBox');
    box.addEventListener('click', () => {
      box.classList.toggle('open');
    });
  </script>
</body>
</html>
